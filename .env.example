# Database Connection (PostgreSQL or SQLite)
# For Supabase / Managed PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres
# For Local testing default SQLite: sqlite:///./shop.db
DATABASE_URL=sqlite:///./shop.db

# JWT Security
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Business Settings Defaults
BUSINESS_NAME=Sri Jayavarman Electricals
BUSINESS_ADDRESS=93A, Thevarpuram Road, Thoothukudi, Tamil Nadu 628002, India
DEFAULT_PHONE=+91 94431 23456
DEFAULT_WHATSAPP=+91 94431 23456
DEFAULT_EMAIL=contact@srijayavarmanelectricals.com
DEFAULT_LATITUDE=8.8078
DEFAULT_LONGITUDE=78.1465
